{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/app",
      "dest": "/api/index.py"
    },
    {
      "src": "/gallery",
      "dest": "/api/index.py"
    },
    {
      "src": "/sw\\.js",
      "dest": "/public/sw.js"
    },
    {
      "src": "/(assets/.+)",
      "dest": "/public/$1"
    },
    {
      "src": "/(favicon\\.svg|icons\\.svg|manifest\\.json)",
      "dest": "/public/$1"
    },
    {
      "src": "/static/(.+)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
